# config/db.properties is git-ignored so passwords never reach GitHub.
# Environment variables HOTEL_DB_URL, HOTEL_DB_USER and HOTEL_DB_PASSWORD override these values.

db.url=jdbc:mysql://localhost:3306/hotel_reservation?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
db.user=root
db.password=
